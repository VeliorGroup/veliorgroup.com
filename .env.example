# Velior Group — server-side environment.
#
# In production this file lives at /etc/veliorgroup/env (root:web, chmod 640)
# and is loaded by the systemd unit. It is NOT read from the repo: never commit
# a filled-in copy.
#
# Without SF_CLIENT_ID / SF_CLIENT_SECRET the contact form still accepts
# submissions and spools every lead to LEAD_SPOOL_DIR — nothing is lost, but
# nothing reaches the CRM either.

# --- Salesforce lead intake -------------------------------------------------
# OAuth 2.0 client credentials against VELIOR_GROUP_PROD.
# Consumer key and secret come from the "Velior Website Lead Intake" external
# client app, which runs as the integration user (never a human admin).
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Production org. Use https://test.salesforce.com against a sandbox.
SF_LOGIN_URL=https://login.salesforce.com

# Salesforce REST API version used for the Lead insert.
SF_API_VERSION=v65.0

# --- Lead spool -------------------------------------------------------------
# Fallback storage when Salesforce is unreachable. Must be persistent and
# writable by the service user: the systemd unit sets PrivateTmp=true, so any
# path under /tmp is wiped on restart and would lose queued leads.
LEAD_SPOOL_DIR=/var/lib/veliorgroup/leads
